# Copy to .env and fill in. `source .env` before running, or use direnv.

# Notion integration token (https://www.notion.so/my-integrations).
# Share every wallet database with the integration or the query returns nothing.
export NOTION_TOKEN=

# EVM chain data. Alchemy is preferred: one key covers every supported network.
export ALCHEMY_API_KEY=
# Etherscan V2 key, used as the fallback and for chains Alchemy does not serve.
export ETHERSCAN_API_KEY=

# Solana mints and first buys.
export HELIUS_API_KEY=

# Optional alert sinks.
export DISCORD_WEBHOOK_URL=
export TELEGRAM_BOT_TOKEN=
export TELEGRAM_CHAT_ID=

# Optional overrides for the knobs tuned most often.
# export TRACKER_MIN_WALLETS=3
# export TRACKER_WINDOW_MINUTES=90
# export TRACKER_LOOKBACK_HOURS=12
