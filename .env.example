# Wallet Monitor environment. Copy to /etc/wallet-monitor.env (production) or
# .env (local). Full reference, with defaults and effects: deploy/environment.md
#
# NOTHING HERE IS REQUIRED. Robinhood Chain, HyperEVM and Ink are read over
# public RPC and the watchlist imports from a published Notion site, so an
# empty file works. These only widen coverage.
#
# Format note: bare KEY=value, no `export`. systemd's EnvironmentFile does not
# understand `export`, and would create a variable literally called
# "export ALCHEMY_API_KEY". For a shell: set -a && . .env && set +a

# --- Chain data ------------------------------------------------------------
# Ethereum, Base, Arbitrum, OP, Polygon, Abstract, Shape, Zora, Berachain,
# ApeChain, Blast.
ALCHEMY_API_KEY=
# Solana mints and first buys.
HELIUS_API_KEY=
# Fallback on chains Etherscan V2 indexes. Never used for Robinhood or Arc.
ETHERSCAN_API_KEY=

# --- Watchlist import ------------------------------------------------------
# Only for Notion tables that are NOT published (sync --use-token).
NOTION_TOKEN=

# --- Alerts (optional) -----------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime ---------------------------------------------------------------
# Keep the bind on loopback in production: the app has no auth of its own and
# relies on the reverse proxy for it.
# TRACKER_HOST=127.0.0.1
# TRACKER_PORT=8787
# TRACKER_CONFIG=/opt/wallet-monitor/config.toml
# TRACKER_DB=/opt/wallet-monitor/data/tracker.sqlite

# --- Tuning ----------------------------------------------------------------
# TRACKER_MIN_WALLETS=3
# TRACKER_WINDOW_MINUTES=90
# TRACKER_LOOKBACK_HOURS=12
